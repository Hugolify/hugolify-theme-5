{
  "fontFamily": {
    "sans": {
      "$value": "Roboto, system-ui, -apple-system, \"Segoe UI\", \"Helvetica Neue\", \"Noto Sans\", \"Liberation Sans\", Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
      "$type": "fontFamily",
      "$description": "$font-family-sans-serif, the text font. The 400 and 700 faces are self-hosted, see assets/css/theme/base/fonts.css."
    },
    "serif": {
      "$value": "\"Playfair Display\", Times, serif",
      "$type": "fontFamily",
      "$description": "$headings-font-family, the 400 face self-hosted. Its generic fallback is serif here, where the SASS theme fell back on sans-serif."
    },
    "heading": {
      "$value": "{fontFamily.serif}",
      "$type": "fontFamily"
    }
  },
  "fontSize": {
    "heading": {
      "01": {
        "$value": "min(1.525rem + 3.3vw, 4rem)",
        "$type": "dimension",
        "$description": "$h1-font-size 4rem. The min() is Bootstrap RFS: the size grows with the viewport and reaches its full value at 1200px."
      },
      "02": {
        "$value": "min(1.375rem + 1.5vw, 2.5rem)",
        "$type": "dimension",
        "$description": "$h2-font-size 2.5rem, same RFS curve."
      },
      "03": {
        "$value": "min(1.325rem + 0.9vw, 2rem)",
        "$type": "dimension",
        "$description": "$h3-font-size 2rem, same RFS curve."
      },
      "04": {
        "$value": "min(1.275rem + 0.3vw, 1.5rem)",
        "$type": "dimension",
        "$description": "$h4-font-size 1.5rem, same RFS curve."
      },
      "05": {
        "$value": "{size.20}",
        "$type": "dimension",
        "$description": "$h5-font-size 1.25rem, under the RFS threshold: fixed."
      },
      "06": {
        "$value": "{fontSize.sm}",
        "$type": "dimension",
        "$description": "$h6-font-size 1rem."
      }
    },
    "small": {
      "$value": "{fontSize.xs}",
      "$type": "dimension",
      "$description": "$small-font-size 0.875rem."
    },
    "text": {
      "$value": "{fontSize.sm}",
      "$type": "dimension",
      "$description": "1rem, fixed, where the design system grows its text from 16 to 18px."
    }
  },
  "fontWeight": {
    "control": {
      "$value": "{fontWeight.bold}",
      "$type": "fontWeight",
      "$description": "$btn-font-weight and $badge-font-weight, both $font-weight-bolder 700."
    },
    "heading": {
      "$value": "{fontWeight.normal}",
      "$type": "fontWeight",
      "$description": "$headings-font-weight 400."
    }
  }
}
